# AI (Gemini) — server-side only, never expose to the browser.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Job discovery — server-side only. Optional: without JOB_SEARCH_API_KEY,
# the app automatically uses labeled demo/fixture job data instead of
# failing (see lib/jobs/providers/). Set JOB_SEARCH_PROVIDER=search once a
# real provider is configured.
JOB_SEARCH_PROVIDER=demo
JOB_SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
