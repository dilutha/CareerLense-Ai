# AI (Gemini) — server-side only, never expose to the browser.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash if unset.
GEMINI_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Job discovery — server-side only.
# JOB_SEARCH_PROVIDER: "real" (default) — ITPro.lk + company-careers, both
# genuinely live, no key needed for either. "demo" switches to labeled
# fixture data only, for local UI work without hitting external services.
JOB_SEARCH_PROVIDER=real
# Optional — the ITPro.lk API doesn't require a key for the job reads this
# app performs (verified live). Only set this if ITPro later requires one
# for reads, or you were issued one for write/application-management
# endpoints this app doesn't currently use.
ITPRO_API_KEY=
# Optional — SerpApi's Google Jobs API (lib/jobs/providers/serpapi.ts),
# the worldwide/aggregator discovery provider (surfaces LinkedIn/Indeed/
# company-site listings via their own apply links, verified against
# SerpApi's documentation). Without it, this provider reports
# "configuration_required" honestly rather than failing. Get a key at
# https://serpapi.com/manage-api-key (never commit a real value here).
SERPAPI_API_KEY=
# Optional — raises GitHub's public API rate limit (60 req/hr
# unauthenticated) for lib/github/. Never required, never used for
# private-repo access.
GITHUB_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WSO2 API Platform — server-side only, never NEXT_PUBLIC_*. When unset,
# server-side calls that would otherwise go through WSO2 (see
# lib/wso2/, lib/career-profile/get-profile-via-wso2.ts) fall back to
# calling Supabase directly instead — the app still works, just without
# the gateway hop. See docs/WSO2_INTEGRATION.md.
# The gateway base URL for the CareerLens API. IMPORTANT: dev and
# production are DIFFERENT WSO2-issued hostnames (look for "-dev" vs
# "-prod" in the URL) — never hardcoded in source, and double-check which
# one is actually set in Vercel's Production environment specifically.
# The example below is illustrative only, not a real endpoint to copy.
WSO2_API_BASE_URL=https://<your-instance-id>-prod.e1-us-east-azure.bijiraapis.dev/careerlense-ai/careerlens-rest-api/v1.0

# --- Production credential mode (preferred): OAuth2 Client Credentials ---
# Set all three of these to use a persistent WSO2 Application credential
# instead of the Developer Portal's short-lived "Get Test Key" (that flow
# issues a token that expires quickly by design — see
# docs/WSO2_INTEGRATION.md §21/§23/§24 for the live evidence). When these
# three are set, lib/wso2/client.ts uses this mode automatically and
# ignores WSO2_API_KEY entirely.
# The token endpoint from your WSO2 Application's OAuth2 credentials screen.
WSO2_TOKEN_URL=
# Consumer Key from the same screen.
WSO2_CONSUMER_KEY=
# Consumer Secret from the same screen — as sensitive as a password.
WSO2_CONSUMER_SECRET=

# --- Legacy/dev credential mode: Developer Portal "Get Test Key" ---
# Only used when the three OAuth2 variables above are NOT all set. Fine
# for local development; expires quickly, so don't rely on it in production.
# The exact header name your WSO2 Developer Portal's "Get Test Key" shows
# (commonly "apikey" on WSO2's newer API Platform product — confirm from
# your own portal rather than assuming). Optional; defaults to "apikey".
WSO2_API_KEY_HEADER=apikey
# The subscription/test key value from the same "Get Test Key" screen.
WSO2_API_KEY=
